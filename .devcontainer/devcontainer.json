
{
  "name": "AI Video Quality Inspector",

  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",

  "remoteUser": "vscode",

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && python -m pip install -r requirements.txt",

  "forwardPorts": [
    8501
  ],

  "portsAttributes": {
    "8501": {
      "label": "AI Video Quality Inspector",
      "onAutoForward": "openBrowser"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true
      }
    }
  }
}
